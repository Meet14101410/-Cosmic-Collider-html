<!DOCTYPE html>
<html>
<head>
    <title>Cosmic Collider</title>
</head>
<body>
    <h1>🌌 Cosmic Collider</h1>
    <p>Click the button to collide particles!</p>
    <button onclick="collide()">Collide</button>
    <p id="result"></p>

    <script>
        function collide() {
            document.getElementById("result").innerHTML =
                "✨ Energy Released: " + Math.floor(Math.random()*1000) + " MeV";
        }
    </script>
</body>
</html>
